{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shadeo-shapes color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="shadeo-section-head">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <div class="shadeo-arrows">
        <button type="button" class="shadeo-arrow" data-shadeo-scroll="prev" aria-controls="ShapeTrack-{{ section.id }}" aria-label="Previous shapes">
          {% render 'shadeo-icon', icon: 'arrow-left' %}
        </button>
        <button type="button" class="shadeo-arrow" data-shadeo-scroll="next" aria-controls="ShapeTrack-{{ section.id }}" aria-label="Next shapes">
          {% render 'shadeo-icon', icon: 'arrow-right' %}
        </button>
      </div>
    </div>

    <ul class="shadeo-shapes__track" id="ShapeTrack-{{ section.id }}" role="list">
      {%- for block in section.blocks -%}
        <li class="shadeo-shapes__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="shadeo-shapes__card">
            <div class="shadeo-shapes__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 16vw, 42vw', alt: block.settings.label
                }}
              {%- else -%}
                {% render 'shadeo-shape-icon', shape: block.settings.shape %}
              {%- endif -%}
            </div>
            <span class="shadeo-shapes__label">{{ block.settings.label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "SHADEO shape carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by frame shape" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Find the shape that suits your face." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Frame shape",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Aviator" },
        {
          "type": "select",
          "id": "shape",
          "label": "Line drawing (shown when no image is uploaded)",
          "options": [
            { "value": "aviator", "label": "Aviator" },
            { "value": "round", "label": "Round" },
            { "value": "square", "label": "Square" },
            { "value": "rectangle", "label": "Rectangle" },
            { "value": "cat-eye", "label": "Cat eye" },
            { "value": "oversized", "label": "Oversized" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "aviator"
        },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "url", "id": "link", "label": "Link (e.g. the Aviator collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SHADEO shape carousel",
      "blocks": [
        { "type": "shape", "settings": { "label": "Aviator", "shape": "aviator" } },
        { "type": "shape", "settings": { "label": "Round", "shape": "round" } },
        { "type": "shape", "settings": { "label": "Square", "shape": "square" } },
        { "type": "shape", "settings": { "label": "Cat Eye", "shape": "cat-eye" } },
        { "type": "shape", "settings": { "label": "Oversized", "shape": "oversized" } },
        { "type": "shape", "settings": { "label": "Shield", "shape": "shield" } }
      ]
    }
  ]
}
{% endschema %}
