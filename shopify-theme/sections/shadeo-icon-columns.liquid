{%- comment -%}
  One flexible section used three ways on the homepage:
  "Trust strip" (strip style), "Why SHADEO" (columns), "Find your perfect frame" (cards).
  Pick the matching preset when you click "Add section" in the theme editor.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shadeo-icons shadeo-icons--{{ section.settings.style }}{% if section.settings.center %} shadeo-icons--center{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="shadeo-section-head{% if section.settings.center %} shadeo-section-head--center{% endif %}" style="{% if section.settings.center %}justify-content:center;text-align:center;{% endif %}">
        <div>
          {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul class="shadeo-icons__grid" role="list" style="--shadeo-cols: {{ section.blocks.size | at_most: section.settings.columns }};">
      {%- for block in section.blocks -%}
        <li class="shadeo-icons__item" {{ block.shopify_attributes }}>
          <span class="shadeo-icons__icon">{% render 'shadeo-icon', icon: block.settings.icon %}</span>
          {%- if block.settings.title != blank -%}<h3 class="shadeo-icons__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="shadeo-icons__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="button{% if block.settings.button_secondary %} button--secondary{% endif %}">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "SHADEO icon columns",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "strip", "label": "Compact strip (trust badges)" },
        { "value": "columns", "label": "Columns" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "columns"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "checkbox", "id": "center", "label": "Center content", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return arrow" },
            { "value": "sun", "label": "Sun" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "chat", "label": "Chat" },
            { "value": "eye", "label": "Eye" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "award", "label": "Award" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "clock", "label": "Clock" },
            { "value": "quiz", "label": "Question" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free delivery" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "On orders over Tk 3,000" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "button_secondary", "label": "Outline button style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "SHADEO trust strip",
      "settings": { "style": "strip", "columns": 4, "color_scheme": "scheme-2", "padding_top": 28, "padding_bottom": 28 },
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free delivery", "text": "On orders over Tk 3,000" } },
        { "type": "item", "settings": { "icon": "return", "title": "7-day returns", "text": "Easy, no-drama exchanges" } },
        { "type": "item", "settings": { "icon": "sun", "title": "100% UV400", "text": "Full UVA + UVB protection" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Pay your way", "text": "COD, bKash, Nagad & cards" } }
      ]
    },
    {
      "name": "SHADEO why us",
      "settings": { "heading": "Why SHADEO", "subheading": "Premium eyewear without the premium markup.", "style": "columns", "columns": 3, "center": true },
      "blocks": [
        { "type": "item", "settings": { "icon": "award", "title": "Premium build", "text": "Hand-polished acetate and lightweight metal frames with sturdy spring hinges, made to last for years." } },
        { "type": "item", "settings": { "icon": "sun", "title": "Real protection", "text": "Every lens blocks 100% of UVA and UVB rays. Polarized options cut glare on roads, water and screens." } },
        { "type": "item", "settings": { "icon": "sparkle", "title": "Fair prices", "text": "We design in-house and sell direct, so you get boutique quality at a fraction of the price." } }
      ]
    },
    {
      "name": "SHADEO find your frame",
      "settings": { "heading": "Find your perfect frame", "subheading": "Not sure what suits you? We've got you.", "style": "cards", "columns": 3 },
      "blocks": [
        { "type": "item", "settings": { "icon": "quiz", "title": "Take the 60-second quiz", "text": "Answer 5 quick questions about your face shape and style. Get frames picked just for you.", "button_label": "Start the quiz" } },
        { "type": "item", "settings": { "icon": "eye", "title": "Try them on virtually", "text": "Use your phone camera to see how any frame looks on your face, live.", "button_label": "Virtual try-on", "button_secondary": true } },
        { "type": "item", "settings": { "icon": "chat", "title": "Ask a stylist", "text": "Send us a selfie on WhatsApp and our team will suggest 3 frames that suit you.", "button_label": "Chat on WhatsApp", "button_secondary": true } }
      ]
    }
  ]
}
{% endschema %}
