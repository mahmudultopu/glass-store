{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="shadeo-look color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="shadeo-section-head">
      <div>
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.instagram_url != blank -%}
        <a href="{{ section.settings.instagram_url }}" class="link underlined-link" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>
      {%- endif -%}
    </div>

    <ul class="shadeo-look__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign look_product = block.settings.product -%}
        <li class="shadeo-look__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 25vw, 50vw'
            }}
          {%- elsif look_product.featured_media -%}
            {{
              look_product.featured_media
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 25vw, 50vw'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if look_product != blank -%}
            <a href="{{ look_product.url }}" class="shadeo-look__tag">
              <strong>{{ look_product.title }}</strong>
              <span>{{ look_product.price | money }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "SHADEO shop the look",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tag @shadeo.bd to be featured." },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" },
    { "type": "text", "id": "instagram_label", "label": "Instagram link text", "default": "Follow @shadeo.bd" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Lifestyle photo (portrait, 4:5)" },
        { "type": "product", "id": "product", "label": "Product in the photo" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SHADEO shop the look",
      "blocks": [
        { "type": "look" },
        { "type": "look" },
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}
